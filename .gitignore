# dependencies
node_modules/
.pnp
.pnp.js

# next
.next/
out/
build/
next-env.d.ts

# embedded local database (disposable)
.pgdata/
.pglite/
*.sqlite
*.sqlite3

# environment — never commit a real value
.env
.env.local
.env*.local
.env.production

# test output — root-anchored on purpose. A bare "coverage/" also matches
# src/app/coverage/ and src/app/api/volumes/[id]/coverage/, which are source
# directories, and silently drops them from every clone and every Git-connected
# deploy while the working tree still looks complete.
/coverage/
/playwright-report/
/test-results/
/blob-report/
/.playwright/

# editors and os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# verification scratch data
verification-*.json
.vercel
